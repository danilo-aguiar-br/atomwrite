# ── Build artifacts ──
/target/
**/*.rs.bk

# ── IDE and editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Environment and secrets ──
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# ── AI tooling and project docs (not versioned) ──
.claude/
docs_prd/
docs_rules/
CLAUDE.md
AGENTS.md
AGENTS.pt-BR.md

# ── Test and runtime logs (development artifacts) ──
*.log

# ── atomwrite WAL sidecars (runtime artifacts, never commit) ──
# Pattern matches: .atomwrite.journal.<target>.atomwrite.journal.json
# and the empty .atomwrite.journal.json sidecar from atomic_write
**/.atomwrite.journal*.json

# ── sqlite-graphrag runtime artifacts (local databases and queues) ──
# Match at repository root OR any nested directory (**/).
# Covers main DB + SQLite sidecars (-shm/-wal) for graphrag, enrich-queue, ingest-queue.
**/graphrag.sqlite
**/graphrag.sqlite-shm
**/graphrag.sqlite-wal
**/.enrich-queue.sqlite
**/.enrich-queue.sqlite-shm
**/.enrich-queue.sqlite-wal
**/.ingest-queue.sqlite
**/.ingest-queue.sqlite-shm
**/.ingest-queue.sqlite-wal

# ── Local cargo config and working notes (never commit) ──
.cargo/config.toml

# ── Local tool/settings directories (never commit) ──
.setting.cyber/
gaps.md
fuzz/corpus/
.serena/


# BEGIN GH_SKILL_HYGIENE
# Managed by ~/.grok/skills/crates-io-gh/scripts/pre-commit-hygiene.sh — do not hand-edit inside markers
# Ensures agent residual, secrets, DBs, media dumps and temp dirs never enter git
# Empty/whitespace-only patterns are rejected (never added). No *.lock patterns.
# --- extensions ---
*.7z
*.log
*.env
*.png
*.jpg
# --- name contains OR extension: .bak ---
*.bak
*.bak.*
*.*.bak
*.*.bak.*
# --- name contains OR extension: .tmp ---
*.tmp
*.tmp.*
*.*.tmp
*.*.tmp.*
# --- name contains OR extension: .journal ---
*.journal
*.journal.*
*.*.journal
*.*.journal.*
# --- name contains OR extension: .atomwrite_tmp ---
*.atomwrite_tmp
*.atomwrite_tmp.*
*atomwrite_tmp*
# --- name contains: _tmp ---
*_tmp*
# --- name contains: .atomwrite- ---
*.atomwrite-*
*atomwrite-*
# --- name contains: .atom_ ---
*.atom_*
*atom_*
# --- name contains: .atom- ---
*.atom-*
*atom-*
# --- name contains: ._agent_tmp ---
*._agent_tmp*
._agent_tmp*
# --- name contains: agent_tmp ---
*agent_tmp*
# --- name contains: .tmp_ ---
*.tmp_*
*.*.tmp_*
# --- named files (any depth) ---
gaps.md
**/gaps.md
graphrag.sqlite
